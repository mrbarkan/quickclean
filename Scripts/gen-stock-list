#!/usr/bin/env python3 -I
"""Seeds Sources/QuickcleanCore/Resources/stock-macos27.json from this Mac's system volume.

Read-only. Collects the names macOS uses for its own components (frameworks, daemons, agents,
system apps) so Library folders named after them can be recognized as Apple's.
Usage: python3 -I Scripts/gen-stock-list > Sources/QuickcleanCore/Resources/stock-macos27.json
"""
import glob
import json
import os
import plistlib

names = set()
bundle_ids = {"com.apple.Safari"}


def add(name):
    name = os.path.splitext(os.path.basename(name.rstrip("/")))[0]
    if len(name) >= 3:
        names.add(name.lower())


for pattern in ["/System/Library/Frameworks/*", "/System/Library/PrivateFrameworks/*",
                "/System/Library/CoreServices/*", "/usr/libexec/*", "/usr/sbin/*",
                "/System/Library/ExtensionKit/Extensions/*", "/System/Library/PreferencePanes/*"]:
    for path in glob.glob(pattern):
        add(path)

for d in ["/System/Library/LaunchAgents", "/System/Library/LaunchDaemons"]:
    for path in glob.glob(d + "/*.plist"):
        try:
            with open(path, "rb") as f:
                job = plistlib.load(f)
        except Exception:
            continue
        program = job.get("Program") or (job.get("ProgramArguments") or [None])[0]
        if program:
            add(program)

for app in glob.glob("/System/Applications/**/*.app", recursive=True) + \
        glob.glob("/System/Cryptexes/App/System/Applications/*.app"):
    add(app)
    try:
        with open(os.path.join(app, "Contents/Info.plist"), "rb") as f:
            info = plistlib.load(f)
        bundle_ids.add(info["CFBundleIdentifier"])
        for key in ("CFBundleName", "CFBundleDisplayName"):
            if info.get(key):
                names.add(info[key].lower())
    except Exception:
        pass

# Apple-created Library folders that don't share a component's name.
manual = """
apple icloud addressbook callhistorydb callhistorytransactions clouddocs knowledge familycircle familycircled
familysettings syncservices mobilesync dock homekit crashreporter diagnosticreports diagnosticreportsfornewhardware
differentialprivacy diskimages databases desktop pictures colorsync controlcenter fileprovider gamekit
intelligenceflow passkit photossearch privacypreservingmeasurement proapps script editor siritsservice
siriTTSService spotlight tv music facetime animoji app store askpermission askpermissiond btserver baseband cloudkit
contextstoreagent windowserver xsan ilifemediabrowser lsmimagecache trickplay tvapp_bag tvappservices
installer_telemetry mobilemeaccounts mcxtools lkdc-setup loginwindow mbuseragent
networkserviceproxy sharedfilelistd tipsd icdd icloudmailagent identityservicesd livefsd localizationswitcherd
locationaccessstored homeenergyd contactsd corespotlightd diagnostics_agent embeddedbinaryvalidationutility
keychains metadata appstore assistant assistants autosave information
""".split()
names.update(n.lower() for n in manual)
names.update({"desktop pictures", "app store", "script editor", "black & white", "blue tone", "gray tone",
              "lab tone", "sepia tone", "websafecolors"})
# Apple-internal names that third-party software also uses for its own folders.
names -= {"sentry", "caches", "purge", "default.store", "profiles", "ambientsettingstests"}
# Generic words that third-party products also use for their folders.
names -= set("""spark flurry airship synapse ruby hydra nexus sage vista pip bash swift focus drift jet recap chat
helper agent daemon service user root index history report daily export importer remote scan check backup
installer uninstall storage store editor console metal mouse keyboard battery lightning code python node java
go git cache data logs log temp tmp update updater settings config preferences sync cloud""".split())

json.dump({
    "appBundleIDs": sorted(bundle_ids),
    "appleNames": sorted(names),
    "protectedHomePaths": ["Documents", "Desktop", "Library/Keychains", "Library/Mail", "Library/Mobile Documents",
                           "Pictures/Photos Library.photoslibrary"],
}, __import__("sys").stdout, indent=1)
